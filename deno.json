{
  "name": "@leonidalekseev/git-repo-cleaner",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "tasks": {
    "start": "deno run --allow-run=git --allow-read --allow-write --allow-env src/main.ts",
    "test": "deno test --allow-run --allow-read --allow-write --allow-env",
    "check": "deno fmt --check && deno lint && deno check src/main.ts",
    "compile": "deno compile --allow-run=git --allow-read --allow-write --allow-env -o dist/git-repo-cleaner src/main.ts"
  },
  "fmt": {
    "lineWidth": 120
  },
  "publish": {
    "include": [
      "src/",
      "README.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
